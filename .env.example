# ── App Branding ───────────────────────────────────────────────────────────────
APP_NAME="BookClubFever Demo"
APP_TAGLINE="A book in. A meeting's worth of conversation out."
APP_DESCRIPTION="An open source, single-feature demo of BookClubFever."

# ── Database ───────────────────────────────────────────────────────────────────
# DATABASE_URL=postgres://localhost/open_bookclubfever_development  # optional override

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── AI Operational Limits ──────────────────────────────────────────────────────
AI_CALLS_PER_USER_PER_DAY=50
AI_GLOBAL_TIMEOUT_SECONDS=15
