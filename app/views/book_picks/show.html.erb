<div class="d-flex justify-content-between align-items-start mb-3 gap-3">
  <div>
    <h1 class="h3 mb-1"><%= @book_pick.title %></h1>
    <p class="text-muted small mb-0">
      <%= link_to "← My book club picks", book_picks_path, class: "text-muted" %>
      &nbsp;&middot;&nbsp; <%= @book_pick.author %>
    </p>
  </div>
  <div class="d-flex gap-2 flex-shrink-0">
    <%= link_to "Edit", edit_book_pick_path(@book_pick), class: "btn btn-outline-secondary btn-sm" %>
    <%= button_to "Delete", book_pick_path(@book_pick),
          method: :delete,
          form: { data: { turbo_confirm: "Delete this book and its openers?" } },
          class: "btn btn-outline-danger btn-sm" %>
  </div>
</div>

<div class="card book-spine mb-4" style="max-width: 820px;">
  <div class="card-body">
    <div class="mb-3"><%= render "book_picks/boundary_badges", book_pick: @book_pick %></div>
    <dl class="row mb-0 small">
      <dt class="col-sm-4 text-muted">How far the club has read</dt>
      <dd class="col-sm-8"><%= @book_pick.read_through_label %></dd>
      <dt class="col-sm-4 text-muted">Club vibe</dt>
      <dd class="col-sm-8"><%= BookPick::CLUB_VIBE_LABELS[@book_pick.club_vibe] %></dd>
      <dt class="col-sm-4 text-muted">Reader notes</dt>
      <dd class="col-sm-8 mb-0 notes-text"><%= @book_pick.reader_notes.presence || "None" %></dd>
    </dl>
  </div>
</div>

<div class="mb-4" style="max-width: 820px;">
  <%= render "book_picks/openers_button", book_pick: @book_pick, label: "Get five openers", button_class: "btn btn-primary" %>
  <p class="text-muted small mt-2 mb-0">
    Five questions to start the conversation, a spoiler-free line for the group chat, and three books to read next.
    The openers stay inside the chapter you set, and never mention who has or hasn&rsquo;t finished. Only the book,
    the boundary, the vibe and your notes are sent, never who you are. Typically takes 5&ndash;15 seconds.
  </p>
</div>

<% if @conversation_sets.any? %>
  <h2 class="h6 text-muted mb-2">Earlier openers</h2>
  <ul class="list-unstyled small" style="max-width: 820px;">
    <% @conversation_sets.each do |set| %>
      <li class="mb-2">
        <%= link_to book_pick_conversation_set_path(@book_pick, set) do %>
          <%= set.generated_at ? "#{time_ago_in_words(set.generated_at)} ago" : "Unknown time" %>
        <% end %>
        &nbsp;
        <% if set.completed? %>
          <span class="text-muted"><%= set.spoiler_boundary %></span>
        <% else %>
          <span class="text-muted fst-italic"><%= set.failed? ? "could not be used" : "still running" %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
